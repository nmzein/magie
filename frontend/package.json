		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@types/node": "25.0.3",
		"@types/eslint": "9.6.1",
		"@types/three": "0.182.0",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.13.1",
		"globals": "16.5.0",
		"prettier": "3.7.4",
		"prettier-plugin-svelte": "3.4.1",
